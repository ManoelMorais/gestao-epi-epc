<Window x:Class="GestaoEpiEpc.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:GestaoEpiEpc.Desktop.Models"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Amperion Energia · Gestão de EPI/EPC" Height="840" Width="1440" WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinHeight="640" MinWidth="1080"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.FontWeight="Regular">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Navegação lateral ===================== -->
        <Border Grid.Column="0" Background="{StaticResource PincelInk}">
            <DockPanel LastChildFill="True">

                <!-- Marca -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,26,20,26">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource PincelGradienteMarca}" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="LightningBolt" Width="20" Height="20" Foreground="White"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AMPERION ENERGIA" FontSize="12.5" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Gestão de EPI/EPC" FontSize="10.5" Foreground="#7C8AA0" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Usuário atual — um único controle: avatar + nome + perfil, clique abre a troca -->
                <ComboBox DockPanel.Dock="Top" Margin="16,0,16,28"
                          ItemsSource="{Binding UsuariosDisponiveis}"
                          SelectedItem="{Binding UsuarioAtual}"
                          Padding="10,8">
                    <ComboBox.Resources>
                        <SolidColorBrush x:Key="MaterialDesign.Brush.ComboBox.OutlineBorder" Color="#242E3D" />
                        <SolidColorBrush x:Key="MaterialDesign.Brush.ComboBox.OutlineInactiveBorder" Color="#242E3D" />
                        <SolidColorBrush x:Key="MaterialDesign.Brush.ComboBox.HoverBorder" Color="{StaticResource CorAzul}" />
                        <SolidColorBrush x:Key="MaterialDesign.Brush.ComboBox.FilledBackground" Color="{StaticResource CorInkAlt}" />
                        <SolidColorBrush x:Key="MaterialDesign.Brush.Foreground" Color="White" />
                    </ComboBox.Resources>
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="MinHeight" Value="52" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <!-- Fundo sólido escuro (em vez de Transparent): a cor de fundo real do Popup
                                             do MaterialDesignThemes não segue as chaves de recurso que tentamos
                                             sobrescrever, então cada linha pinta o próprio fundo para garantir
                                             contraste com o texto âmbar abaixo. -->
                                        <Border x:Name="Fundo" Background="{StaticResource PincelInkAlt}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Fundo" Property="Background" Value="#20293A" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Fundo" Property="Background" Value="#1C2634" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3" VerticalAlignment="Center">
                                <Border Style="{StaticResource Avatar}" Width="32" Height="32">
                                    <TextBlock Text="{Binding Nome, Converter={StaticResource Iniciais}}"
                                               Foreground="White" FontWeight="Bold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nome}" FontSize="12.5" FontWeight="Bold" Foreground="#FFA552" />
                                    <TextBlock Text="{Binding Perfil, Converter={StaticResource PerfilUsuarioParaTexto}}" FontSize="10.5" Foreground="#8B93A3" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Rodapé -->
                <StackPanel DockPanel.Dock="Bottom" Margin="24,10,20,22">
                    <Separator Background="#1C2532" Margin="0,0,0,12" />
                    <TextBlock Text="Amperion Energia S.A." FontSize="10.5" Foreground="#5B6472" />
                    <TextBlock Text="v0.1 · ambiente de demonstração" FontSize="10" Foreground="#454E5C" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Navegação -->
                <ListBox DockPanel.Dock="Top"
                         Style="{StaticResource ListaMenuLateral}"
                         ItemsSource="{Binding ItensMenu}"
                         SelectedItem="{Binding ItemSelecionado}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:NavItem}">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="IconeFundo" Width="30" Height="30" CornerRadius="8" Background="#171F2C">
                                    <materialDesign:PackIcon x:Name="Icone" Kind="{Binding Icone}" Width="16" Height="16" Foreground="#9AA4B5"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="Rotulo" Text="{Binding Titulo}" VerticalAlignment="Center" FontSize="13.5" Margin="12,0,0,0" Foreground="#AEB6C4" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="IconeFundo" Property="Background" Value="{StaticResource PincelAzul}" />
                                    <Setter TargetName="Icone" Property="Foreground" Value="White" />
                                    <Setter TargetName="Rotulo" Property="Foreground" Value="White" />
                                    <Setter TargetName="Rotulo" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>
        </Border>

        <!-- ===================== Conteúdo ===================== -->
        <Border Grid.Column="1" Background="{StaticResource PincelPaper}" Padding="32,28,32,28">
            <ContentControl Content="{Binding ViewModelAtual}" />
        </Border>
    </Grid>
</Window>
