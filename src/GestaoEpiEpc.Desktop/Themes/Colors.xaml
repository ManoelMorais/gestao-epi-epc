<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta da marca (Amperion Energia) — o Material Design cobre os controles padrão;
         estes tokens são usados na navegação, cabeçalhos e indicadores próprios do app. -->
    <Color x:Key="CorInk">#0F1720</Color>
    <Color x:Key="CorInkAlt">#161F2C</Color>
    <Color x:Key="CorInkSoft">#4B5566</Color>
    <Color x:Key="CorPaper">#F3F4F8</Color>
    <Color x:Key="CorSurface">#FFFFFF</Color>
    <Color x:Key="CorLinha">#E5E7EE</Color>
    <Color x:Key="CorAzul">#1D4ED8</Color>
    <Color x:Key="CorAzulEscuro">#1638A6</Color>
    <Color x:Key="CorAzulSuave">#EAF0FE</Color>
    <Color x:Key="CorLaranja">#E85D19</Color>
    <Color x:Key="CorLaranjaSuave">#FDECE1</Color>
    <Color x:Key="CorVerde">#1E824C</Color>
    <Color x:Key="CorVerdeSuave">#E7F5EC</Color>
    <Color x:Key="CorVermelho">#C4321A</Color>
    <Color x:Key="CorVermelhoSuave">#FBE7E2</Color>
    <Color x:Key="CorRoxo">#6D28D9</Color>
    <Color x:Key="CorRoxoSuave">#F1E8FD</Color>
    <Color x:Key="CorCiano">#0E7490</Color>
    <Color x:Key="CorCianoSuave">#E1F3F7</Color>

    <SolidColorBrush x:Key="PincelInk" Color="{StaticResource CorInk}" />
    <SolidColorBrush x:Key="PincelInkAlt" Color="{StaticResource CorInkAlt}" />
    <SolidColorBrush x:Key="PincelInkSuave" Color="{StaticResource CorInkSoft}" />
    <SolidColorBrush x:Key="PincelPaper" Color="{StaticResource CorPaper}" />
    <SolidColorBrush x:Key="PincelSurface" Color="{StaticResource CorSurface}" />
    <SolidColorBrush x:Key="PincelLinha" Color="{StaticResource CorLinha}" />
    <SolidColorBrush x:Key="PincelAzul" Color="{StaticResource CorAzul}" />
    <SolidColorBrush x:Key="PincelAzulEscuro" Color="{StaticResource CorAzulEscuro}" />
    <SolidColorBrush x:Key="PincelAzulSuave" Color="{StaticResource CorAzulSuave}" />
    <SolidColorBrush x:Key="PincelLaranja" Color="{StaticResource CorLaranja}" />
    <SolidColorBrush x:Key="PincelLaranjaSuave" Color="{StaticResource CorLaranjaSuave}" />
    <SolidColorBrush x:Key="PincelVerde" Color="{StaticResource CorVerde}" />
    <SolidColorBrush x:Key="PincelVerdeSuave" Color="{StaticResource CorVerdeSuave}" />
    <SolidColorBrush x:Key="PincelVermelho" Color="{StaticResource CorVermelho}" />
    <SolidColorBrush x:Key="PincelVermelhoSuave" Color="{StaticResource CorVermelhoSuave}" />
    <SolidColorBrush x:Key="PincelRoxo" Color="{StaticResource CorRoxo}" />
    <SolidColorBrush x:Key="PincelRoxoSuave" Color="{StaticResource CorRoxoSuave}" />
    <SolidColorBrush x:Key="PincelCiano" Color="{StaticResource CorCiano}" />
    <SolidColorBrush x:Key="PincelCianoSuave" Color="{StaticResource CorCianoSuave}" />
    <SolidColorBrush x:Key="PincelBranco" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="PincelGradienteMarca" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource CorAzul}" Offset="0" />
        <GradientStop Color="{StaticResource CorAzulEscuro}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PincelGradienteGrafico" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4D1D4ED8" Offset="0" />
        <GradientStop Color="#001D4ED8" Offset="1" />
    </LinearGradientBrush>

    <!-- Sobrescreve as cores "de fábrica" do Material Design pelas cores exatas da marca,
         para que TextBox/ComboBox/DatePicker/CheckBox (estilizados automaticamente pelo
         BundledTheme) fiquem no mesmo azul/laranja usado no resto do app, em vez do
         azul genérico mais próximo que o Material escolheria sozinho. -->
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary" Color="{StaticResource CorAzul}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Light" Color="{StaticResource CorAzulSuave}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Light.Foreground" Color="{StaticResource CorAzul}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Dark" Color="{StaticResource CorAzulEscuro}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Dark.Foreground" Color="White" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Foreground" Color="White" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary" Color="{StaticResource CorLaranja}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary.Light" Color="{StaticResource CorLaranjaSuave}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary.Light.Foreground" Color="{StaticResource CorLaranja}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary.Dark" Color="{StaticResource CorLaranja}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary.Dark.Foreground" Color="White" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary.Foreground" Color="White" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.TextBox.OutlineBorder" Color="{StaticResource CorLinha}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.ComboBox.OutlineBorder" Color="{StaticResource CorLinha}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.TextBox.OutlineInactiveBorder" Color="{StaticResource CorLinha}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.ComboBox.OutlineInactiveBorder" Color="{StaticResource CorLinha}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.TextBox.HoverBorder" Color="{StaticResource CorAzul}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.ComboBox.HoverBorder" Color="{StaticResource CorAzul}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.TextBox.FilledBackground" Color="{StaticResource CorSurface}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.TextBox.HoverBackground" Color="{StaticResource CorSurface}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.ComboBox.FilledBackground" Color="{StaticResource CorSurface}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.ComboBox.HoverBackground" Color="{StaticResource CorPaper}" />

</ResourceDictionary>
