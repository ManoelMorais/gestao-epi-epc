<UserControl x:Class="GestaoEpiEpc.Desktop.Views.ColaboradoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" d:DesignWidth="1000">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="OPERAÇÃO" Style="{StaticResource Eyebrow}" Margin="0,0,0,4" />
                <TextBlock Text="Colaboradores" Style="{StaticResource Titulo1}" />
                <TextBlock Text="Consulta somente leitura — a base vem de RH/Active Directory (RF05). Cada colaborador acessa o app com o próprio DRT. Clique numa linha para ver o que está em posse e o histórico de movimentações (com estorno)." Style="{StaticResource TextoSecundario}" Margin="0,4,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Nome ou DRT" />
                <Button Grid.Column="1" Content="Buscar" Style="{StaticResource BotaoPrimario}" Margin="10,0,0,0"
                        Command="{Binding BuscarCommand}" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Cartao}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Colaboradores}" IsReadOnly="True" BorderThickness="0"
                              PreviewMouseLeftButtonUp="DataGrid_PreviewMouseLeftButtonUp">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DRT" Binding="{Binding Drt}" Width="90" ElementStyle="{StaticResource CelulaCentralizada}" />
                            <DataGridTemplateColumn Header="Nome" Width="340">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource PincelAzulSuave}">
                                                <TextBlock Text="{Binding Nome, Converter={StaticResource Iniciais}}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{StaticResource PincelAzul}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Nome}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Cargo" Width="300">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="BriefcaseOutline" Width="14" Height="14" Foreground="{StaticResource PincelInkSuave}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Cargo.Nome}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Unidade" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Unidade.Nome}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}" Background="{Binding Status, Converter={StaticResource StatusColaboradorParaCor}}" Opacity="0.9">
                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding Carregando, Converter={StaticResource BoolParaVisibilidade}}">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="3" Foreground="{StaticResource PincelAzul}" />
                        <TextBlock Text="Carregando colaboradores..." Style="{StaticResource TextoSecundario}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Visibility>
                            <MultiBinding Converter="{StaticResource EstadoVazioParaVisibilidade}">
                                <Binding Path="Carregando" />
                                <Binding Path="Colaboradores.Count" />
                            </MultiBinding>
                        </StackPanel.Visibility>
                        <materialDesign:PackIcon Kind="AccountSearchOutline" Width="38" Height="38" Foreground="{StaticResource PincelInkSuave}" HorizontalAlignment="Center" />
                        <TextBlock Text="Nenhum colaborador encontrado" Style="{StaticResource TextoSecundario}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay do popup de detalhes -->
        <Border Background="#99000000" Visibility="{Binding MostrarDetalhes, Converter={StaticResource BoolParaVisibilidade}}"
                MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
            <Border Style="{StaticResource CartaoPopup}" MaxWidth="640" Width="640" MaxHeight="760" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="PopupCard_MouseLeftButtonDown">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" Background="{StaticResource PincelAzulSuave}" Margin="0,0,14,0">
                            <TextBlock Text="{Binding ColaboradorSelecionado.Nome, Converter={StaticResource Iniciais}}" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource PincelAzul}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ColaboradorSelecionado.Nome}" Style="{StaticResource Titulo2}" FontSize="17" />
                            <TextBlock Text="{Binding ColaboradorSelecionado.Drt, StringFormat=DRT {0}}" Style="{StaticResource TextoSecundario}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <StackPanel Margin="0,0,10,16">
                            <TextBlock Text="CARGO" Style="{StaticResource RotuloDetalhe}" />
                            <TextBlock Text="{Binding ColaboradorSelecionado.Cargo.Nome}" Style="{StaticResource ValorDetalhe}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="UNIDADE" Style="{StaticResource RotuloDetalhe}" />
                            <TextBlock Text="{Binding ColaboradorSelecionado.Unidade.Nome}" Style="{StaticResource ValorDetalhe}" />
                        </StackPanel>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <StackPanel Margin="0,0,10,16">
                            <TextBlock Text="ÁREA" Style="{StaticResource RotuloDetalhe}" />
                            <TextBlock Text="{Binding ColaboradorSelecionado.Area}" Style="{StaticResource ValorDetalhe}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="ADMISSÃO" Style="{StaticResource RotuloDetalhe}" />
                            <TextBlock Text="{Binding ColaboradorSelecionado.Admissao, StringFormat=dd/MM/yyyy}" Style="{StaticResource ValorDetalhe}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,16">
                            <TextBlock Text="E-MAIL" Style="{StaticResource RotuloDetalhe}" />
                            <TextBlock Text="{Binding ColaboradorSelecionado.Email}" Style="{StaticResource ValorDetalhe}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="TELEFONE" Style="{StaticResource RotuloDetalhe}" />
                            <TextBlock Text="{Binding ColaboradorSelecionado.Telefone}" Style="{StaticResource ValorDetalhe}" />
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="STATUS" Style="{StaticResource RotuloDetalhe}" Margin="0,0,0,6" />
                        <Border Style="{StaticResource Chip}" Background="{Binding ColaboradorSelecionado.Status, Converter={StaticResource StatusColaboradorParaCor}}" Opacity="0.9">
                            <TextBlock Text="{Binding ColaboradorSelecionado.Status}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <!-- Abas da ficha: o que está com ele agora / tudo o que já foi movimentado -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton Style="{StaticResource AbaFiltro}" GroupName="AbaFicha" IsChecked="{Binding MostrandoPosse, Mode=TwoWay}" Margin="0,0,8,0">
                            <TextBlock>
                                <Run Text="Em posse" /> <Run Text="{Binding ItensEmPosse.Count, Mode=OneWay, StringFormat=({0})}" />
                            </TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource AbaFiltro}" GroupName="AbaFicha" IsChecked="{Binding MostrandoHistorico, Mode=TwoWay}">
                            <TextBlock>
                                <Run Text="Histórico de movimentações" /> <Run Text="{Binding Historico.Count, Mode=OneWay, StringFormat=({0})}" />
                            </TextBlock>
                        </RadioButton>
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="3" Foreground="{StaticResource PincelAzul}" Margin="0,4,0,8"
                                 Visibility="{Binding CarregandoFicha, Converter={StaticResource BoolParaVisibilidade}}" />

                    <!-- Histórico (entregas iniciais, trocas, reposições, devoluções), com estorno -->
                    <StackPanel Visibility="{Binding MostrandoHistorico, Converter={StaticResource BoolParaVisibilidade}}">
                        <TextBlock Text="Nenhuma movimentação registrada." Style="{StaticResource TextoSecundario}" Margin="0,0,0,8">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource EstadoVazioParaVisibilidade}">
                                    <Binding Path="CarregandoFicha" />
                                    <Binding Path="Historico.Count" />
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Historico}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource PincelLinha}" BorderThickness="0,0,0,1" Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource Chip}" Padding="7,2" Margin="0,0,8,0"
                                                            Background="{Binding TipoMovimentacao, Converter={StaticResource TipoMovimentacaoParaCor}}">
                                                        <TextBlock Text="{Binding TipoMovimentacao, Converter={StaticResource TipoMovimentacaoParaTexto}}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding DataHora, StringFormat=dd/MM/yyyy HH:mm}" FontSize="12" Foreground="{StaticResource PincelInkSuave}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Itens, Converter={StaticResource ItensParaTexto}}" Foreground="{StaticResource PincelInk}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource PincelInkSuave}" TextWrapping="Wrap">
                                                    <Run Text="{Binding Motivo.Descricao, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding Facilitador.Nome, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Observacao}" FontSize="11" FontStyle="Italic" Foreground="{StaticResource PincelInkSuave}" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <Trigger Property="Text" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Border Style="{StaticResource Chip}" HorizontalAlignment="Right"
                                                        Background="{Binding Status, Converter={StaticResource StatusEntregaParaCor}}">
                                                    <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                                <Button Content="Estornar" Style="{StaticResource BotaoTexto}" Foreground="{StaticResource PincelVermelho}"
                                                        HorizontalAlignment="Right" Margin="0,4,0,0" Padding="6,2" Click="Estornar_Click">
                                                    <Button.Visibility>
                                                        <MultiBinding Converter="{StaticResource PodeEstornarParaVisibilidade}">
                                                            <Binding Path="Status" />
                                                            <Binding Path="DataContext.PodeEstornar" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        </MultiBinding>
                                                    </Button.Visibility>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Itens em posse (mesma visão do app) -->
                    <StackPanel Visibility="{Binding MostrandoPosse, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="Nenhum EPI/EPC com este colaborador." Style="{StaticResource TextoSecundario}" Margin="0,0,0,8">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource EstadoVazioParaVisibilidade}">
                                <Binding Path="CarregandoFicha" />
                                <Binding Path="ItensEmPosse.Count" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding ItensEmPosse}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource PincelLinha}" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource PincelAzulSuave}" Margin="0,0,12,0">
                                            <materialDesign:PackIcon Kind="{Binding Item.Categoria.Tipo, Converter={StaticResource TipoItemParaIcone}}" Width="17" Height="17"
                                                                     Foreground="{StaticResource PincelAzul}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Item.Nome}" Foreground="{StaticResource PincelInk}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11" Foreground="{StaticResource PincelInkSuave}">
                                                <Run Text="{Binding Quantidade, StringFormat={}{0} un.,Mode=OneWay}" />
                                                <Run Text="{Binding Tamanho, StringFormat=· Tam. {0}, TargetNullValue='', Mode=OneWay}" />
                                                <Run Text="{Binding RecebidoEm, StringFormat=· Recebido em {0:dd/MM/yyyy}, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource Chip}" Background="{Binding DiasParaVencer, Converter={StaticResource DiasParaVencerParaCor}}">
                                            <TextBlock Text="{Binding DiasParaVencer, Converter={StaticResource DiasParaVencerParaTexto}}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>

                    <Button Grid.Row="1" Content="Fechar" Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Right" Margin="0,18,0,0"
                            Command="{Binding FecharDetalhesCommand}" />
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
