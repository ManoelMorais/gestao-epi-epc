<UserControl x:Class="GestaoEpiEpc.Desktop.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" d:DesignWidth="1100">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="ADMINISTRAÇÃO" Style="{StaticResource Eyebrow}" Margin="0,0,0,4" />
                <TextBlock Text="Usuários" Style="{StaticResource Titulo1}" />
                <TextBlock Text="Contas de acesso ao desktop e seus perfis (RF21). Clique numa linha para ver os detalhes." Style="{StaticResource TextoSecundario}" Margin="0,4,0,0" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Cartao}" Padding="0">
                  <Grid>
                    <DataGrid ItemsSource="{Binding Usuarios}" IsReadOnly="True" BorderThickness="0"
                              SelectedItem="{Binding UsuarioSelecionado}"
                              PreviewMouseLeftButtonUp="DataGrid_PreviewMouseLeftButtonUp">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Nome" Width="300">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="14" Background="{Binding Perfil, Converter={StaticResource PerfilUsuarioParaCor}}">
                                                <TextBlock Text="{Binding Nome, Converter={StaticResource Iniciais}}" FontSize="11" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Nome}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Perfil" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}" Background="{Binding Perfil, Converter={StaticResource PerfilUsuarioParaCor}}" Opacity="0.9">
                                            <TextBlock Text="{Binding Perfil, Converter={StaticResource PerfilUsuarioParaTexto}}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Opacity="0.9">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                                    <Setter Property="Background" Value="{StaticResource PincelInkSuave}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ativo}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource PincelVerde}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Inativo" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Ativo}" Value="True">
                                                                <Setter Property="Text" Value="Ativo" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding Carregando, Converter={StaticResource BoolParaVisibilidade}}">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="3" Foreground="{StaticResource PincelAzul}" />
                        <TextBlock Text="Carregando usuários..." Style="{StaticResource TextoSecundario}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Visibility>
                            <MultiBinding Converter="{StaticResource EstadoVazioParaVisibilidade}">
                                <Binding Path="Carregando" />
                                <Binding Path="Usuarios.Count" />
                            </MultiBinding>
                        </StackPanel.Visibility>
                        <materialDesign:PackIcon Kind="AccountOffOutline" Width="38" Height="38" Foreground="{StaticResource PincelInkSuave}" HorizontalAlignment="Center" />
                        <TextBlock Text="Nenhum usuário encontrado" Style="{StaticResource TextoSecundario}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Cartao}" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource PincelAzulSuave}" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="AccountPlusOutline" Width="17" Height="17" Foreground="{StaticResource PincelAzul}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Novo usuário / edição" Style="{StaticResource Titulo2}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Nome" Style="{StaticResource TextoSecundario}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="E-mail corporativo" Style="{StaticResource TextoSecundario}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Perfil" Style="{StaticResource TextoSecundario}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding PerfisDisponiveis}" SelectedItem="{Binding PerfilSelecionado}" Margin="0,0,0,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource PerfilUsuarioParaTexto}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Unidade" Style="{StaticResource TextoSecundario}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Unidades}" SelectedItem="{Binding UnidadeSelecionada}"
                                  DisplayMemberPath="Nome" Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Novo" Style="{StaticResource BotaoSecundario}" Command="{Binding NovoUsuarioCommand}" Margin="0,0,10,0" />
                            <Button Content="Salvar" Style="{StaticResource BotaoPrimario}" Command="{Binding SalvarCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoSecundario}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Overlay do popup de detalhes -->
        <Border Background="#99000000" Visibility="{Binding MostrarDetalhes, Converter={StaticResource BoolParaVisibilidade}}"
                MouseLeftButtonDown="Overlay_MouseLeftButtonDown" Panel.ZIndex="1">
            <Border Style="{StaticResource CartaoPopup}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="PopupCard_MouseLeftButtonDown">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" Margin="0,0,14,0"
                                Background="{Binding UsuarioSelecionado.Perfil, Converter={StaticResource PerfilUsuarioParaCor}}">
                            <TextBlock Text="{Binding UsuarioSelecionado.Nome, Converter={StaticResource Iniciais}}" FontSize="18" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UsuarioSelecionado.Nome}" Style="{StaticResource Titulo2}" FontSize="17" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UsuarioSelecionado.Email}" Style="{StaticResource TextoSecundario}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <StackPanel Margin="0,0,10,16">
                            <TextBlock Text="PERFIL" Style="{StaticResource RotuloDetalhe}" Margin="0,0,0,6" />
                            <Border Style="{StaticResource Chip}" Background="{Binding UsuarioSelecionado.Perfil, Converter={StaticResource PerfilUsuarioParaCor}}" Opacity="0.9">
                                <TextBlock Text="{Binding UsuarioSelecionado.Perfil, Converter={StaticResource PerfilUsuarioParaTexto}}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="UNIDADE" Style="{StaticResource RotuloDetalhe}" />
                            <TextBlock Text="{Binding UsuarioSelecionado.Unidade.Nome}" Style="{StaticResource ValorDetalhe}" />
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Margin="0,0,0,22">
                        <TextBlock Text="STATUS" Style="{StaticResource RotuloDetalhe}" Margin="0,0,0,6" />
                        <Border Opacity="0.9">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                    <Setter Property="Background" Value="{StaticResource PincelInkSuave}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsuarioSelecionado.Ativo}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PincelVerde}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Inativo" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UsuarioSelecionado.Ativo}" Value="True">
                                                <Setter Property="Text" Value="Ativo" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Inativar" Style="{StaticResource BotaoPerigo}" Margin="0,0,10,0"
                                Command="{Binding InativarCommand}" CommandParameter="{Binding UsuarioSelecionado}" />
                        <Button Content="Editar" Style="{StaticResource BotaoSecundario}" Margin="0,0,10,0"
                                Command="{Binding FecharDetalhesCommand}" />
                        <Button Content="Fechar" Style="{StaticResource BotaoSecundario}" Command="{Binding FecharDetalhesCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
