<UserControl x:Class="GestaoEpiEpc.Desktop.Views.AuditoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GestaoEpiEpc.Desktop.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" d:DesignWidth="1100">
    <Grid>
        <Border Background="#99000000" Visibility="{Binding MostrarDetalhes, Converter={StaticResource BoolParaVisibilidade}}"
                MouseLeftButtonDown="Overlay_MouseLeftButtonDown" Panel.ZIndex="1">
            <Border Style="{StaticResource CartaoPopup}" MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="PopupCard_MouseLeftButtonDown">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" Background="{StaticResource PincelGradienteMarca}" Margin="0,0,14,0">
                            <TextBlock Text="{Binding LogSelecionado.Usuario.Nome, Converter={StaticResource Iniciais}}" FontSize="18" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LogSelecionado.Usuario.Nome}" Style="{StaticResource Titulo2}" FontSize="17" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding LogSelecionado.DataHora, StringFormat=dd/MM/yyyy HH:mm}" Style="{StaticResource TextoSecundario}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <StackPanel Margin="0,0,10,16">
                            <TextBlock Text="ENTIDADE" Style="{StaticResource RotuloDetalhe}" />
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TagOutline" Width="14" Height="14" Foreground="{StaticResource PincelInkSuave}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding LogSelecionado.Entidade}" Style="{StaticResource ValorDetalhe}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="AÇÃO" Style="{StaticResource RotuloDetalhe}" />
                            <TextBlock Text="{Binding LogSelecionado.Acao}" Style="{StaticResource ValorDetalhe}" />
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="ANTES" Style="{StaticResource RotuloDetalhe}" />
                        <Border Background="{StaticResource PincelVermelhoSuave}" CornerRadius="8" Padding="10,8" Margin="0,4,0,0">
                            <TextBlock Text="{Binding LogSelecionado.DadosAntes}" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource PincelInk}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,22">
                        <TextBlock Text="DEPOIS" Style="{StaticResource RotuloDetalhe}" />
                        <Border Background="{StaticResource PincelVerdeSuave}" CornerRadius="8" Padding="10,8" Margin="0,4,0,0">
                            <TextBlock Text="{Binding LogSelecionado.DadosDepois}" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource PincelInk}" />
                        </Border>
                    </StackPanel>

                    <Button Content="Fechar" Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Right"
                            Command="{Binding FecharDetalhesCommand}" />
                </StackPanel>
            </Border>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="COMPLIANCE" Style="{StaticResource Eyebrow}" Margin="0,0,0,4" />
                <TextBlock Text="Auditoria" Style="{StaticResource Titulo1}" />
                <TextBlock Text="Trilha imutável de alterações relevantes (RF24) — sustenta auditorias de SST/NR-6. Clique numa linha para ver o antes/depois." Style="{StaticResource TextoSecundario}" Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Cartao}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="De" Style="{StaticResource TextoSecundario}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding DataInicio}" Width="130" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Até" Style="{StaticResource TextoSecundario}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding DataFim}" Width="130" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Entidade" Style="{StaticResource TextoSecundario}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{x:Static local:AuditoriaViewModel.EntidadesConhecidas}"
                                  SelectedItem="{Binding EntidadeFiltro}" Width="180" IsEditable="True" />
                    </StackPanel>
                    <Button Content="Consultar" Style="{StaticResource BotaoPrimario}" VerticalAlignment="Bottom" Margin="0,0,10,0"
                            Command="{Binding ConsultarCommand}" />
                    <Button Content="Limpar filtros" Style="{StaticResource BotaoTexto}" VerticalAlignment="Bottom"
                            Command="{Binding LimparFiltrosCommand}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Cartao}" Padding="0">
              <Grid>
                <DataGrid ItemsSource="{Binding Logs}" IsReadOnly="True" BorderThickness="0"
                          PreviewMouseLeftButtonUp="DataGrid_PreviewMouseLeftButtonUp">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora, StringFormat=dd/MM/yyyy HH:mm}" Width="150" ElementStyle="{StaticResource CelulaCentralizada}" />
                        <DataGridTemplateColumn Header="Usuário" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource PincelGradienteMarca}">
                                            <TextBlock Text="{Binding Usuario.Nome, Converter={StaticResource Iniciais}}" FontSize="10" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Usuario.Nome}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Entidade" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="TagOutline" Width="14" Height="14" Foreground="{StaticResource PincelInkSuave}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Entidade}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ação" Binding="{Binding Acao}" Width="260" ElementStyle="{StaticResource CelulaCentralizada}" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding Carregando, Converter={StaticResource BoolParaVisibilidade}}">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="3" Foreground="{StaticResource PincelAzul}" />
                    <TextBlock Text="Carregando auditoria..." Style="{StaticResource TextoSecundario}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{StaticResource EstadoVazioParaVisibilidade}">
                            <Binding Path="Carregando" />
                            <Binding Path="Logs.Count" />
                        </MultiBinding>
                    </StackPanel.Visibility>
                    <materialDesign:PackIcon Kind="ClipboardTextOffOutline" Width="38" Height="38" Foreground="{StaticResource PincelInkSuave}" HorizontalAlignment="Center" />
                    <TextBlock Text="Nenhum registro encontrado no período" Style="{StaticResource TextoSecundario}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
