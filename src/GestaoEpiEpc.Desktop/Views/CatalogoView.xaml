<UserControl x:Class="GestaoEpiEpc.Desktop.Views.CatalogoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" d:DesignWidth="1100">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="GESTÃO" Style="{StaticResource Eyebrow}" Margin="0,0,0,4" />
                <TextBlock Text="Catálogo de EPI/EPC" Style="{StaticResource Titulo1}" />
                <TextBlock Text="Cadastro de itens — categoria, CA, validade padrão (RF07-RF09). Clique numa linha para ver os detalhes." Style="{StaticResource TextoSecundario}" Margin="0,4,0,0" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <!-- Lista -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Buscar" Style="{StaticResource BotaoPrimario}" Margin="10,0,0,0"
                                Command="{Binding BuscarCommand}" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Cartao}" Padding="0">
                      <Grid>
                        <DataGrid ItemsSource="{Binding Itens}" IsReadOnly="True" BorderThickness="0"
                                  SelectedItem="{Binding ItemSelecionado}"
                                  PreviewMouseLeftButtonUp="DataGrid_PreviewMouseLeftButtonUp">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Item" Width="320">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="28" Height="28" CornerRadius="8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource PincelAzulSuave}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Categoria.Tipo}" Value="Epc">
                                                                    <Setter Property="Background" Value="{StaticResource PincelLaranjaSuave}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <materialDesign:PackIcon Kind="{Binding Categoria.Tipo, Converter={StaticResource TipoItemParaIcone}}" Width="15" Height="15"
                                                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Foreground" Value="{StaticResource PincelAzul}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Categoria.Tipo}" Value="Epc">
                                                                        <Setter Property="Foreground" Value="{StaticResource PincelLaranja}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </Border>
                                                <StackPanel Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Codigo}" Style="{StaticResource TextoSecundario}" FontSize="11" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria.Nome}" Width="260" ElementStyle="{StaticResource CelulaCentralizada}" />
                                <DataGridTemplateColumn Header="Status" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Opacity="0.9">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                                        <Setter Property="Background" Value="{StaticResource PincelInkSuave}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Ativo}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource PincelVerde}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Inativo" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ativo}" Value="True">
                                                                    <Setter Property="Text" Value="Ativo" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                    Visibility="{Binding Carregando, Converter={StaticResource BoolParaVisibilidade}}">
                            <ProgressBar IsIndeterminate="True" Width="120" Height="3" Foreground="{StaticResource PincelAzul}" />
                            <TextBlock Text="Carregando catálogo..." Style="{StaticResource TextoSecundario}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel.Visibility>
                                <MultiBinding Converter="{StaticResource EstadoVazioParaVisibilidade}">
                                    <Binding Path="Carregando" />
                                    <Binding Path="Itens.Count" />
                                </MultiBinding>
                            </StackPanel.Visibility>
                            <materialDesign:PackIcon Kind="PackageVariantClosedRemove" Width="38" Height="38" Foreground="{StaticResource PincelInkSuave}" HorizontalAlignment="Center" />
                            <TextBlock Text="Nenhum item encontrado" Style="{StaticResource TextoSecundario}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                      </Grid>
                    </Border>
                </Grid>

                <!-- Formulário -->
                <Border Grid.Column="2" Style="{StaticResource Cartao}" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource PincelAzulSuave}" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="ShieldPlusOutline" Width="17" Height="17" Foreground="{StaticResource PincelAzul}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Novo item / edição" Style="{StaticResource Titulo2}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Código" Style="{StaticResource TextoSecundario}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Nome" Style="{StaticResource TextoSecundario}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Categoria" Style="{StaticResource TextoSecundario}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSelecionada}"
                                  DisplayMemberPath="Nome" Margin="0,0,0,10" />

                        <TextBlock Text="Número do CA" Style="{StaticResource TextoSecundario}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NumeroCa, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Validade padrão (meses)" Style="{StaticResource TextoSecundario}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ValidadePadraoMeses, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <CheckBox Content="Possui tamanho" IsChecked="{Binding PossuiTamanho}" Margin="0,4,0,16" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Novo" Style="{StaticResource BotaoSecundario}" Command="{Binding NovoItemCommand}" Margin="0,0,10,0" />
                            <Button Content="Salvar" Style="{StaticResource BotaoPrimario}" Command="{Binding SalvarCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoSecundario}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Overlay do popup de detalhes -->
        <Border Background="#99000000" Visibility="{Binding MostrarDetalhes, Converter={StaticResource BoolParaVisibilidade}}"
                MouseLeftButtonDown="Overlay_MouseLeftButtonDown" Panel.ZIndex="1">
            <Border Style="{StaticResource CartaoPopup}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="PopupCard_MouseLeftButtonDown">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Margin="0,0,14,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource PincelAzulSuave}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ItemSelecionado.Categoria.Tipo}" Value="Epc">
                                            <Setter Property="Background" Value="{StaticResource PincelLaranjaSuave}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <materialDesign:PackIcon Kind="{Binding ItemSelecionado.Categoria.Tipo, Converter={StaticResource TipoItemParaIcone}}" Width="22" Height="22"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Foreground" Value="{StaticResource PincelAzul}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ItemSelecionado.Categoria.Tipo}" Value="Epc">
                                                <Setter Property="Foreground" Value="{StaticResource PincelLaranja}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ItemSelecionado.Nome}" Style="{StaticResource Titulo2}" FontSize="17" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ItemSelecionado.Codigo}" Style="{StaticResource TextoSecundario}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <StackPanel Margin="0,0,10,16">
                            <TextBlock Text="CATEGORIA" Style="{StaticResource RotuloDetalhe}" />
                            <TextBlock Text="{Binding ItemSelecionado.Categoria.Nome}" Style="{StaticResource ValorDetalhe}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="NÚMERO DO CA" Style="{StaticResource RotuloDetalhe}" />
                            <TextBlock Text="{Binding ItemSelecionado.NumeroCa, TargetNullValue=—}" Style="{StaticResource ValorDetalhe}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="VALIDADE PADRÃO" Style="{StaticResource RotuloDetalhe}" />
                            <TextBlock Text="{Binding ItemSelecionado.ValidadePadraoMeses, StringFormat={}{0} meses, TargetNullValue=—}" Style="{StaticResource ValorDetalhe}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="TAMANHO" Style="{StaticResource RotuloDetalhe}" />
                            <TextBlock Text="{Binding ItemSelecionado.PossuiTamanho, Converter={StaticResource BoolParaSimNao}}" Style="{StaticResource ValorDetalhe}" />
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Margin="0,0,0,22">
                        <TextBlock Text="STATUS" Style="{StaticResource RotuloDetalhe}" Margin="0,0,0,6" />
                        <Border Opacity="0.9">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                    <Setter Property="Background" Value="{StaticResource PincelInkSuave}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ItemSelecionado.Ativo}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PincelVerde}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Inativo" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ItemSelecionado.Ativo}" Value="True">
                                                <Setter Property="Text" Value="Ativo" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Inativar" Style="{StaticResource BotaoPerigo}" Margin="0,0,10,0"
                                Command="{Binding InativarCommand}" CommandParameter="{Binding ItemSelecionado}" />
                        <Button Content="Editar" Style="{StaticResource BotaoSecundario}" Margin="0,0,10,0"
                                Command="{Binding FecharDetalhesCommand}" />
                        <Button Content="Fechar" Style="{StaticResource BotaoSecundario}" Command="{Binding FecharDetalhesCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
