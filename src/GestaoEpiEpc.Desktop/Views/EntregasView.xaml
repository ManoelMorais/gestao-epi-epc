<UserControl x:Class="GestaoEpiEpc.Desktop.Views.EntregasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1150"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Border Background="#99000000" Visibility="{Binding MostrarDetalhes, Converter={StaticResource BoolParaVisibilidade}}"
                MouseLeftButtonDown="Overlay_MouseLeftButtonDown" Panel.ZIndex="1">
            <Border Style="{StaticResource CartaoPopup}" MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="PopupCard_MouseLeftButtonDown">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" Background="{StaticResource PincelAzulSuave}" Margin="0,0,14,0">
                            <TextBlock Text="{Binding EntregaSelecionada.Colaborador.Nome, Converter={StaticResource Iniciais}}" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource PincelAzul}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EntregaSelecionada.Colaborador.Nome}" Style="{StaticResource Titulo2}" FontSize="17" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding EntregaSelecionada.Colaborador.Cargo.Nome}" Style="{StaticResource TextoSecundario}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource Chip}" VerticalAlignment="Top"
                                Background="{Binding EntregaSelecionada.Status, Converter={StaticResource StatusEntregaParaCor}}" Opacity="0.9">
                            <TextBlock Text="{Binding EntregaSelecionada.Status}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <StackPanel Margin="0,0,10,16">
                            <TextBlock Text="DATA/HORA" Style="{StaticResource RotuloDetalhe}" />
                            <TextBlock Text="{Binding EntregaSelecionada.DataHora, StringFormat=dd/MM/yyyy HH:mm}" Style="{StaticResource ValorDetalhe}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="TIPO" Style="{StaticResource RotuloDetalhe}" Margin="0,0,0,6" />
                            <Border Style="{StaticResource Chip}" Background="{Binding EntregaSelecionada.TipoMovimentacao, Converter={StaticResource TipoMovimentacaoParaCor}}" Opacity="0.9">
                                <TextBlock Text="{Binding EntregaSelecionada.TipoMovimentacao, Converter={StaticResource TipoMovimentacaoParaTexto}}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,16">
                            <TextBlock Text="FACILITADOR" Style="{StaticResource RotuloDetalhe}" />
                            <TextBlock Text="{Binding EntregaSelecionada.Facilitador.Nome}" Style="{StaticResource ValorDetalhe}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="MOTIVO" Style="{StaticResource RotuloDetalhe}" />
                            <TextBlock Text="{Binding EntregaSelecionada.Motivo.Descricao}" Style="{StaticResource ValorDetalhe}" />
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Margin="0,0,0,22">
                        <TextBlock Text="ITENS ENTREGUES" Style="{StaticResource RotuloDetalhe}" />
                        <TextBlock Text="{Binding EntregaSelecionada.Itens, Converter={StaticResource ItensParaTexto}}" Style="{StaticResource ValorDetalhe}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Estornar" Style="{StaticResource BotaoPerigo}" Margin="0,0,10,0"
                                Visibility="{Binding PodeEstornar, Converter={StaticResource BoolParaVisibilidade}}"
                                Click="Estornar_Click" />
                        <Button Content="Fechar" Style="{StaticResource BotaoSecundario}" Command="{Binding FecharDetalhesCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="ACOMPANHAMENTO" Style="{StaticResource Eyebrow}" Margin="0,0,0,4" />
                <TextBlock Text="Entregas" Style="{StaticResource Titulo1}" />
                <TextBlock Text="Acompanhamento e histórico de todas as movimentações (RF16/RF17). Clique numa linha para ver os detalhes." Style="{StaticResource TextoSecundario}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Filtros -->
            <Border Grid.Row="1" Style="{StaticResource Cartao}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="De" Style="{StaticResource TextoSecundario}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding DataInicio}" Width="130" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Até" Style="{StaticResource TextoSecundario}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding DataFim}" Width="130" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Colaborador" Style="{StaticResource TextoSecundario}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding ColaboradoresDisponiveis}" SelectedItem="{Binding ColaboradorFiltro}"
                                  DisplayMemberPath="Nome" Width="220" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Tipo de movimentação" Style="{StaticResource TextoSecundario}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding TiposDisponiveis}" SelectedItem="{Binding TipoMovimentacaoFiltro}" Width="180">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource TipoMovimentacaoParaTexto}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button Content="Consultar" Style="{StaticResource BotaoPrimario}" VerticalAlignment="Bottom" Margin="0,0,10,0"
                            Command="{Binding ConsultarCommand}" />
                    <Button Content="Limpar filtros" Style="{StaticResource BotaoTexto}" VerticalAlignment="Bottom"
                            Command="{Binding LimparFiltrosCommand}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Cartao}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Resultados}" IsReadOnly="True" BorderThickness="0"
                              PreviewMouseLeftButtonUp="DataGrid_PreviewMouseLeftButtonUp">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding DataHora, StringFormat=dd/MM/yyyy HH:mm}" Width="140" ElementStyle="{StaticResource CelulaCentralizada}" />
                            <DataGridTemplateColumn Header="Colaborador" Width="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource PincelAzulSuave}">
                                                <TextBlock Text="{Binding Colaborador.Nome, Converter={StaticResource Iniciais}}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource PincelAzul}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Colaborador.Nome}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Tipo" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}" Background="{Binding TipoMovimentacao, Converter={StaticResource TipoMovimentacaoParaCor}}" Opacity="0.9">
                                            <TextBlock Text="{Binding TipoMovimentacao, Converter={StaticResource TipoMovimentacaoParaTexto}}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}"
                                                Background="{Binding Status, Converter={StaticResource StatusEntregaParaCor}}"
                                                Opacity="0.9">
                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding Carregando, Converter={StaticResource BoolParaVisibilidade}}">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="3" Foreground="{StaticResource PincelAzul}" />
                        <TextBlock Text="Carregando entregas..." Style="{StaticResource TextoSecundario}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Visibility>
                            <MultiBinding Converter="{StaticResource EstadoVazioParaVisibilidade}">
                                <Binding Path="Carregando" />
                                <Binding Path="Resultados.Count" />
                            </MultiBinding>
                        </StackPanel.Visibility>
                        <materialDesign:PackIcon Kind="TruckOutline" Width="38" Height="38" Foreground="{StaticResource PincelInkSuave}" HorizontalAlignment="Center" />
                        <TextBlock Text="Nenhuma entrega encontrada" Style="{StaticResource TextoSecundario}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
