<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GestaoEpiEpc.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GestaoEpiEpc.Mobile.Views"
    Title="Amperion EPI/EPC"
    FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Registrar"
                      ContentTemplate="{DataTemplate views:RegistrarEntregaPage}"
                      Route="registrar" />
        <ShellContent Title="Histórico"
                      ContentTemplate="{DataTemplate views:HistoricoPage}"
                      Route="historico" />
    </TabBar>

</Shell>
