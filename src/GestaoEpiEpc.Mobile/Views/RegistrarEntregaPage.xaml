<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="GestaoEpiEpc.Mobile.Views.RegistrarEntregaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:GestaoEpiEpc.Mobile.Models"
    xmlns:entities="clr-namespace:GestaoEpiEpc.Domain.Entities;assembly=GestaoEpiEpc.Domain"
    Title="Registrar entrega"
    BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">

            <!-- Facilitador -->
            <Frame BackgroundColor="White" CornerRadius="12" Padding="14" HasShadow="False" BorderColor="Transparent">
                <VerticalStackLayout Spacing="4">
                    <Label Text="FACILITADOR" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Picker ItemsSource="{Binding FacilitadoresDisponiveis}" ItemDisplayBinding="{Binding Nome}"
                            SelectedItem="{Binding FacilitadorSelecionado}" Title="Selecione o facilitador" />
                </VerticalStackLayout>
            </Frame>

            <!-- Busca de colaborador (só aparece se ninguém foi selecionado ainda) -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding ColaboradorSelecionado, Converter={StaticResource NuloParaBool}, ConverterParameter=inverso}">
                <Frame BackgroundColor="White" CornerRadius="12" Padding="4" HasShadow="False" BorderColor="Transparent">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Grid.Column="0" Placeholder="Buscar colaborador por nome ou matrícula"
                               Text="{Binding TermoBusca}" ReturnCommand="{Binding BuscarCommand}" Margin="8,0" />
                        <Button Grid.Column="1" Text="Buscar" Command="{Binding BuscarCommand}"
                                BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="10" />
                    </Grid>
                </Frame>

                <CollectionView ItemsSource="{Binding ResultadosBusca}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="entities:Colaborador">
                            <Frame BackgroundColor="White" CornerRadius="10" Padding="14" Margin="0,0,0,8" HasShadow="False" BorderColor="Transparent">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelecionarColaboradorCommand}"
                                                           CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="15" />
                                    <Label Text="{Binding Matricula, StringFormat='Matrícula {0}'}" FontSize="12" TextColor="{StaticResource Gray500}" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Colaborador selecionado + itens elegíveis -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding ColaboradorSelecionado, Converter={StaticResource NuloParaBool}}">
                <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="12" Padding="14" HasShadow="False" BorderColor="Transparent">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding ColaboradorSelecionado.Nome}" FontAttributes="Bold" FontSize="16" TextColor="White" />
                            <Label Text="{Binding ColaboradorSelecionado.Cargo.Nome}" FontSize="12.5" TextColor="{StaticResource Secondary}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Trocar" Command="{Binding TrocarColaboradorCommand}"
                                BackgroundColor="Transparent" TextColor="White" BorderColor="White" BorderWidth="1" CornerRadius="8"
                                FontSize="12" Padding="10,4" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <ActivityIndicator IsRunning="{Binding CarregandoItens}" IsVisible="{Binding CarregandoItens}" Color="{StaticResource Primary}" />

                <Label Text="Itens elegíveis para o cargo" FontAttributes="Bold" FontSize="14"
                       IsVisible="{Binding CarregandoItens, Converter={StaticResource NuloParaBool}, ConverterParameter=inverso}" />

                <CollectionView ItemsSource="{Binding ItensElegiveis}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ItemEntregaSelecionavel">
                            <Frame BackgroundColor="White" CornerRadius="10" Padding="12" Margin="0,0,0,8" HasShadow="False" BorderColor="Transparent">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Selecionado}" Color="{StaticResource Primary}" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                        <Label Text="{Binding Item.Nome}" FontSize="14" FontAttributes="Bold" />
                                        <Label Text="{Binding Item.Categoria.Nome}" FontSize="11.5" TextColor="{StaticResource Gray500}" />
                                    </VerticalStackLayout>
                                    <Stepper Grid.Column="2" Value="{Binding Quantidade}" Minimum="1" Maximum="20"
                                             IsEnabled="{Binding Selecionado}" VerticalOptions="Center" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Detalhes da movimentação -->
                <Frame BackgroundColor="White" CornerRadius="12" Padding="14" HasShadow="False" BorderColor="Transparent">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="TIPO DE MOVIMENTAÇÃO" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Picker ItemsSource="{Binding TiposDisponiveis}" SelectedItem="{Binding TipoSelecionado}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="MOTIVO" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Picker ItemsSource="{Binding Motivos}" ItemDisplayBinding="{Binding Descricao}" SelectedItem="{Binding MotivoSelecionado}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="OBSERVAÇÃO (OPCIONAL)" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Editor Text="{Binding Observacao}" HeightRequest="70" AutoSize="TextChanges" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Button Text="Registrar entrega" Command="{Binding RegistrarCommand}"
                        BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="12"
                        FontAttributes="Bold" HeightRequest="52" IsEnabled="{Binding Registrando, Converter={StaticResource NuloParaBool}, ConverterParameter=inverso}" />

                <ActivityIndicator IsRunning="{Binding Registrando}" IsVisible="{Binding Registrando}" Color="{StaticResource Primary}" />
            </VerticalStackLayout>

            <Label Text="{Binding Mensagem}" IsVisible="{Binding Mensagem, Converter={StaticResource NuloParaBool}}"
                   FontAttributes="Bold" HorizontalTextAlignment="Center" Padding="4">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding MensagemEhErro}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource Erro}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding MensagemEhErro}" Value="False">
                        <Setter Property="TextColor" Value="{StaticResource Sucesso}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
